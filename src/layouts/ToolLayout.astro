---
import Layout from './Layout.astro';
import { tools, type ToolDef } from '../data/tools';

interface Props {
  tool: ToolDef;
}

const { tool } = Astro.props;
const related = tools.filter((t) => t.slug !== tool.slug).slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.title,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: tool.description,
    url: `https://tools.slyxup.in/${tool.slug}/`,
    keywords: tool.keywords.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tool.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<Layout title={`${tool.title} — Free Online Tool`} description={tool.description} slug={tool.slug} jsonLd={jsonLd}>
  <div class="tool-container">
    <nav class="mb-4 flex items-center gap-1 text-sm text-slate-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>/</span>
      <span class="text-slate-700">{tool.shortTitle}</span>
    </nav>

    <div class="mb-2 flex items-center gap-2">
      <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">{tool.category}</span>
      <span class="text-xs text-slate-400">Free · No signup</span>
    </div>

    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{tool.title}</h1>
    <p class="mt-3 max-w-2xl text-base text-slate-600">{tool.description}</p>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <slot name="tool" />
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-slate-900">{tool.title} — Frequently Asked Questions</h2>
      <div class="mt-4 space-y-3">
        {tool.faqs.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{f.question}</h3>
            <p class="mt-1 text-sm text-slate-600">{f.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-slate-900">More Free Tools</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {related.map((t) => (
          <a
            href={`/${t.slug}`}
            class="group rounded-xl border border-slate-200 bg-white p-4 transition-shadow hover:shadow-md"
          >
            <p class="font-semibold text-slate-900 group-hover:text-brand-600">{t.shortTitle}</p>
            <p class="mt-1 line-clamp-2 text-sm text-slate-500">{t.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
