---
import { categories } from '../data/tools';

const labels: Record<string, string> = {
  Document: 'Documents',
  Image: 'Images',
  Design: 'Design',
  AI: 'AI',
  SEO: 'SEO',
};
---

<header class="nav-shell">
  <div class="tool-container flex h-16 items-center justify-between">
    <a href="/" class="group flex items-center gap-2.5">
      <span
        class="grid h-9 w-9 place-items-center rounded-xl transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-105"
      >
        <svg viewBox="0 0 512 512" fill="none" class="h-6 w-6" aria-hidden="true">
          <defs>
            <linearGradient id="ths" x1="105" y1="415" x2="405" y2="85" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#08736F"/>
              <stop offset=".38" stop-color="#08AFA7"/>
              <stop offset=".72" stop-color="#25D8CE"/>
              <stop offset="1" stop-color="#7AFFF7"/>
            </linearGradient>
          </defs>
          <path d="M368 91C329 68 274 64 220 77 165 90 124 121 111 160 96 202 112 239 151 266 170 279 194 291 218 303 234 311 243 320 241 331 239 343 225 348 210 343 191 337 174 327 157 318L113 370c19 15 38 28 60 38 46 22 100 18 132-11 32-28 37-70 15-103-16-25-42-43-73-59L201 211c-16-9-23-18-19-29 5-15 22-25 42-27 34-4 67 5 97 27l47-91Z" fill="url(#ths)"/>
          <path d="M368 91c-33-19-74-25-113-19-47 6-86 24-114 51-20 20-29 43-30 65-2 32 15 58 46 79 19 12 41 22 62 34L247 235l-46-24c-16-9-23-18-19-29 5-15 22-25 42-27 34-4 67 5 97 27Z" fill="#07958F"/>
          <path d="M368 91L321 182c14 11 26 21 35 32 9-17 17-35 23-54 6-23 3-49-11-69Z" fill="#21D2C8"/>
          <path d="M247 235c29 15 53 32 70 56 23 32 18 74-13 104-32 31-85 35-131 13-22-10-41-23-60-38l44-52c17 9 34 19 53 25 15 5 29 0 31-12 2-11-9-20-29-25-19-10-41-22-63-36Z" fill="#076E6A"/>
        </svg>
      </span>
      <span class="display text-lg font-bold tracking-tight text-mist-100">
        slyxup<span class="text-mist-500">/tools</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Categories">
      <a href="/#tools" class:list={['nav-link font-mono uppercase', Astro.url.pathname === '/' && 'is-active']}>
        All
      </a>
      {categories.map((c) => (
        <a
          href={`/#tools?cat=${encodeURIComponent(c)}`}
          class="nav-link font-mono uppercase"
        >
          {labels[c] ?? c}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="grid h-9 w-9 place-items-center rounded-lg text-mist-300 transition-colors hover:text-mist-100"
        style="border: 1px solid var(--chrome-border-strong)"
      >
        <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>
      <a href="/#tools" class="btn-volt hidden !px-4 !py-2 text-xs sm:inline-flex">All tools</a>
      <button
        id="menu-btn"
        type="button"
        aria-label="Toggle menu"
        class="grid h-9 w-9 place-items-center rounded-lg border border-white/10 text-mist-300 transition-colors hover:text-mist-100 lg:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden" style="border-top: 1px solid var(--chrome-border);">
    <nav class="tool-container flex flex-col py-3" aria-label="Mobile categories">
      <a href="/#tools" class="nav-link rounded-lg px-3 py-2.5 font-mono uppercase">All</a>
      {categories.map((c) => (
        <a href={`/#tools?cat=${encodeURIComponent(c)}`} class="nav-link rounded-lg px-3 py-2.5 font-mono uppercase">
          {labels[c] ?? c}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => menu.classList.add('hidden'));
  });

  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;
  function currentTheme() {
    return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }
  function applyTheme(next: string) {
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  }
  toggle?.addEventListener('click', () => {
    applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
  });
</script>
