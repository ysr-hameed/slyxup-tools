---
import { tools } from '../data/tools';

const documents = tools.filter((t) => t.category === 'Document');
const rest = tools.filter((t) => t.category !== 'Document');
---

<footer class="relative mt-24 overflow-hidden" style="border-top: 1px solid var(--chrome-border);">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-64 bg-[radial-gradient(60%_100%_at_50%_100%,rgba(210,255,63,0.08),transparent)]" aria-hidden="true" />

  <div class="tool-container grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]" style="border-bottom: 1px solid var(--chrome-border);">
    <div>
      <a href="/" class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center rounded-lg">
          <svg viewBox="0 0 512 512" fill="none" class="h-5 w-5" aria-hidden="true">
            <defs>
              <linearGradient id="tfs" x1="105" y1="415" x2="405" y2="85" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#08736F"/>
                <stop offset=".38" stop-color="#08AFA7"/>
                <stop offset=".72" stop-color="#25D8CE"/>
                <stop offset="1" stop-color="#7AFFF7"/>
              </linearGradient>
            </defs>
            <path d="M368 91C329 68 274 64 220 77 165 90 124 121 111 160 96 202 112 239 151 266 170 279 194 291 218 303 234 311 243 320 241 331 239 343 225 348 210 343 191 337 174 327 157 318L113 370c19 15 38 28 60 38 46 22 100 18 132-11 32-28 37-70 15-103-16-25-42-43-73-59L201 211c-16-9-23-18-19-29 5-15 22-25 42-27 34-4 67 5 97 27l47-91Z" fill="url(#tfs)"/>
            <path d="M368 91c-33-19-74-25-113-19-47 6-86 24-114 51-20 20-29 43-30 65-2 32 15 58 46 79 19 12 41 22 62 34L247 235l-46-24c-16-9-23-18-19-29 5-15 22-25 42-27 34-4 67 5 97 27Z" fill="#07958F"/>
            <path d="M368 91L321 182c14 11 26 21 35 32 9-17 17-35 23-54 6-23 3-49-11-69Z" fill="#21D2C8"/>
            <path d="M247 235c29 15 53 32 70 56 23 32 18 74-13 104-32 31-85 35-131 13-22-10-41-23-60-38l44-52c17 9 34 19 53 25 15 5 29 0 31-12 2-11-9-20-29-25-19-10-41-22-63-36Z" fill="#076E6A"/>
          </svg>
        </span>
        <span class="display text-lg font-bold tracking-tight text-mist-100">
          slyxup<span class="text-mist-500">/tools</span>
        </span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-mist-400">
        Free online tools for documents, images, design, AI, and SEO. Fast, private, and free forever — no signup, no
        watermark, no catch.
      </p>
      <div class="mt-5 flex items-center gap-2">
        <span class="chip">Free forever</span>
        <span class="chip">No signup</span>
      </div>
    </div>

    <div>
      <p class="mono-label mb-4 text-mist-500">Documents</p>
      <ul class="space-y-2.5">
        {documents.map((t) => (
          <li>
            <a href={`/${t.slug}`} class="text-sm text-mist-400 transition-colors hover:text-volt-300">
              {t.shortTitle}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="mono-label mb-4 text-mist-500">More tools</p>
      <ul class="space-y-2.5">
        {rest.map((t) => (
          <li>
            <a href={`/${t.slug}`} class="text-sm text-mist-400 transition-colors hover:text-volt-300">
              {t.shortTitle}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="mono-label mb-4 text-mist-500">Slyxup</p>
      <ul class="space-y-2.5 text-sm text-mist-400">
        <li><a href="/" class="transition-colors hover:text-volt-300">All tools</a></li>
        <li><a href="/#why" class="transition-colors hover:text-volt-300">Why free</a></li>
        <li><a href="https://slyxup.in" class="transition-colors hover:text-volt-300">slyxup.in</a></li>
      </ul>
    </div>
  </div>

  <div class="tool-container flex flex-col items-center justify-between gap-3 py-6 text-xs text-mist-500 sm:flex-row">
    <p>&copy; {new Date().getFullYear()} Slyxup Tools · tools.slyxup.in</p>
    <p class="font-mono uppercase tracking-[0.2em]">Built for the web · free forever</p>
  </div>

  <div class="relative pb-2">
    <div class="footer-wordmark" aria-hidden="true">SLYXUP</div>
  </div>
</footer>
