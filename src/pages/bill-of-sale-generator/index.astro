---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getTool } from '../../data/tools';
import DocumentEditor from '../../components/tools/DocumentEditor.tsx';

const tool = getTool('bill-of-sale-generator')!;
const config = {
  heading: 'Bill of Sale',
  accent: [16, 185, 129] as [number, number, number],
  tableHeaders: ['Item Description', 'Qty', 'Price', 'Amount'],
  showTax: false,
  showDiscount: false,
  showClient: true,
  showDueDate: false,
  clientLabel: 'Buyer',
  downloadName: 'bill-of-sale',
};
---

<ToolLayout tool={tool}>
  <DocumentEditor client:load config={config} />
</ToolLayout>
