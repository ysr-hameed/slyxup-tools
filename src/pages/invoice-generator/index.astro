---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getTool } from '../../data/tools';
import DocumentEditor from '../../components/tools/DocumentEditor.tsx';

const tool = getTool('invoice-generator')!;
const config = {
  heading: 'Invoice',
  accent: [79, 70, 229] as [number, number, number],
  tableHeaders: ['Description', 'Qty', 'Rate', 'Amount'],
  showTax: true,
  showDiscount: true,
  showClient: true,
  showDueDate: true,
  downloadName: 'invoice',
};
---

<ToolLayout tool={tool}>
  <DocumentEditor client:load config={config} key="invoice" />
</ToolLayout>
