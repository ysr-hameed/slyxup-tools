---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Slyxup Tools',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.title,
      url: `https://tools.slyxup.in/${t.slug}/`,
    })),
  },
];
---

<Layout
  title="Slyxup Tools — Free Online Tools for Documents, AI & SEO"
  description="100% free online tools: create invoices, bills of sale, quotes, receipts, rental agreements, resize images, generate color palettes, humanize AI text, and check SEO rankings. No signup, no watermark."
  jsonLd={jsonLd}
>
  <section class="tool-container py-12 text-center">
    <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
      Free Online Tools for Documents, AI & SEO
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
      Create invoices, bills of sale, and rental agreements in seconds. Resize images, generate palettes,
      humanize AI text, and check Google rankings — all free, all private, no signup.
    </p>
  </section>

  <section class="tool-container">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((t) => (
        <a
          href={`/${t.slug}`}
          class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg"
        >
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">
              {t.category}
            </span>
            <span class="text-xs text-slate-400">Free</span>
          </div>
          <h2 class="mt-3 text-lg font-semibold text-slate-900 group-hover:text-brand-600">
            {t.shortTitle}
          </h2>
          <p class="mt-1 line-clamp-2 text-sm text-slate-500">{t.description}</p>
          <span class="mt-4 text-sm font-medium text-brand-600">Open tool →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="tool-container mt-12">
    <div class="rounded-2xl bg-brand-50 p-6">
      <h2 class="text-xl font-bold text-slate-900">Why use Slyxup Tools?</h2>
      <ul class="mt-3 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-brand-600">✓</span> 100% free, no hidden fees or watermark
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-brand-600">✓</span> No signup or email required
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-brand-600">✓</span> Private — files process in your browser
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-brand-600">✓</span> Fast, clean, and mobile-friendly
        </li>
      </ul>
    </div>
  </section>
</Layout>
