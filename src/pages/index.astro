---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
import ToolExplorer from '../components/tools/ToolExplorer.tsx';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Slyxup Tools',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.title,
      url: `https://tools.slyxup.in/${t.slug}/`,
    })),
  },
];
---

<Layout
  title="Slyxup Tools — Free Online Tools for Documents, AI & SEO"
  description="100% free online tools: create invoices, bills of sale, quotes, receipts, rental agreements, resize images, generate color palettes, humanize AI text, and check SEO rankings. No signup, no watermark."
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="hero-grid absolute inset-0" aria-hidden="true" />
    <div class="orb left-[-12%] top-[-22%] h-[420px] w-[420px] bg-volt-400/20" aria-hidden="true" />
    <div class="orb right-[-10%] top-[4%] h-[380px] w-[380px] bg-violet-500/20" style="animation-delay:-5s" aria-hidden="true" />

    <div class="tool-container relative py-24 text-center sm:py-32">
      <p class="mono-label" data-reveal>Slyxup · Free utility studio</p>

      <h1
        class="mx-auto mt-6 max-w-5xl font-display text-5xl font-semibold leading-[0.98] tracking-[-0.04em] sm:text-7xl lg:text-8xl"
        data-reveal
        style="--reveal-delay:120ms"
      >
        Free tools,
        <br />
        <em class="text-volt-300">serious</em> craft.
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-mist-400 sm:text-lg" data-reveal style="--reveal-delay:240ms">
        Create invoices, receipts, and rental agreements in seconds. Resize images, generate palettes, humanize AI
        text, and check your rankings — all free, all private, no signup.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-reveal style="--reveal-delay:360ms">
        <a href="#tools" class="btn-volt">Explore the toolbox</a>
        <a href="#why" class="btn-ghost">Why free forever</a>
      </div>

      <div class="mt-16 grid grid-cols-2 gap-8 sm:grid-cols-4" data-reveal style="--reveal-delay:480ms">
        <div>
          <p class="font-display text-3xl font-bold text-mist-100 sm:text-4xl">10</p>
          <p class="mono-label mt-1.5">Free tools</p>
        </div>
        <div>
          <p class="font-display text-3xl font-bold text-mist-100 sm:text-4xl">100%</p>
          <p class="mono-label mt-1.5">Free forever</p>
        </div>
        <div>
          <p class="font-display text-3xl font-bold text-mist-100 sm:text-4xl">0</p>
          <p class="mono-label mt-1.5">Signups needed</p>
        </div>
        <div>
          <p class="font-display text-3xl font-bold text-mist-100 sm:text-4xl">0</p>
          <p class="mono-label mt-1.5">Watermarks</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee-mask border-y border-white/5 py-5" data-reveal>
    <div class="marquee-track">
      {[0, 1].map((copy) => (
        <div class="flex shrink-0 items-center" aria-hidden={copy === 1}>
          {tools.map((t) => (
            <span class="mx-5 flex items-center gap-5 font-mono text-xs uppercase tracking-[0.22em] text-mist-500">
              <svg viewBox="0 0 10 10" class="h-2 w-2 text-volt-400" fill="currentColor" aria-hidden="true">
                <rect width="10" height="10" rx="2" />
              </svg>
              {t.shortTitle}
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- TOOLS -->
  <section class="tool-container scroll-mt-24 py-24">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <p class="mono-label">The toolbox</p>
        <h2 class="mt-3 font-display text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">
          Ten tools. <em class="text-volt-300">Zero friction.</em>
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-mist-500">
        Every tool runs free, private, and instantly — no account, no ads, no watermark. Pick one and go.
      </p>
    </div>
    <ToolExplorer client:load />
  </section>

  <!-- WHY -->
  <section id="why" class="tool-container scroll-mt-24 py-24">
    <div class="mb-10 max-w-2xl" data-reveal>
      <p class="mono-label">Why slyxup</p>
      <h2 class="mt-3 font-display text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">
        Honest tools, <em class="text-volt-300">zero</em> strings.
      </h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="glass rounded-2xl p-6" data-reveal>
        <span class="icon-chip bg-gradient-to-br from-volt-300 to-lime-600">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-ink-950" aria-hidden="true">
            <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </span>
        <h3 class="mt-4 font-display text-lg font-semibold text-mist-100">Free forever</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-mist-400">
          Unlimited use, unlimited downloads. No tiers hiding the good stuff — every feature is unlocked.
        </p>
      </div>

      <div class="glass rounded-2xl p-6" data-reveal style="--reveal-delay:100ms">
        <span class="icon-chip bg-gradient-to-br from-violet-400 to-indigo-600">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-ink-950" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <line x1="19" x2="19" y1="8" y2="14" />
            <line x1="22" x2="16" y1="11" y2="11" />
          </svg>
        </span>
        <h3 class="mt-4 font-display text-lg font-semibold text-mist-100">No signup</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-mist-400">
          No email, no password, no walls. Open a tool and start working — that is the entire process.
        </p>
      </div>

      <div class="glass rounded-2xl p-6" data-reveal style="--reveal-delay:200ms">
        <span class="icon-chip bg-gradient-to-br from-sky-400 to-blue-600">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-ink-950" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </span>
        <h3 class="mt-4 font-display text-lg font-semibold text-mist-100">Private by design</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-mist-400">
          Documents and images are processed in your browser. Nothing is stored, tracked, or shared.
        </p>
      </div>

      <div class="glass rounded-2xl p-6" data-reveal style="--reveal-delay:300ms">
        <span class="icon-chip bg-gradient-to-br from-fuchsia-400 to-purple-600">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-ink-950" aria-hidden="true">
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
        </span>
        <h3 class="mt-4 font-display text-lg font-semibold text-mist-100">Built for speed</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-mist-400">
          No bloat, no loaders you have to stare at. Results appear the moment you ask for them.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="tool-container py-24">
    <div
      class="relative overflow-hidden rounded-3xl border border-volt-400/20 bg-gradient-to-br from-ink-800 to-ink-900 px-6 py-16 text-center sm:px-12"
      data-reveal
    >
      <div class="orb right-[-10%] top-[-60%] h-72 w-72 bg-volt-400/15" aria-hidden="true" />
      <p class="mono-label">Ready when you are</p>
      <h2 class="mx-auto mt-4 max-w-3xl font-display text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">
        Stop wrestling with templates. <em class="text-volt-300">Start creating.</em>
      </h2>
      <div class="mt-8 flex justify-center">
        <a href="#tools" class="btn-volt">Pick a tool</a>
      </div>
    </div>
  </section>
</Layout>
