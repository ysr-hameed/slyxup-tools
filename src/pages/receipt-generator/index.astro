---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getTool } from '../../data/tools';
import DocumentEditor from '../../components/tools/DocumentEditor.tsx';

const tool = getTool('receipt-generator')!;
const config = {
  heading: 'Receipt',
  accent: [245, 158, 11] as [number, number, number],
  tableHeaders: ['Description', 'Qty', 'Rate', 'Amount'],
  showTax: true,
  showDiscount: false,
  showClient: true,
  showDueDate: false,
  clientLabel: 'Customer',
  downloadName: 'receipt',
};
---

<ToolLayout tool={tool}>
  <DocumentEditor client:load config={config} />
</ToolLayout>
