---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — Slyxup Tools"
  description="This page could not be found. Head back to the Slyxup Tools toolbox."
>
  <section class="relative overflow-hidden">
    <div class="hero-grid absolute inset-0" aria-hidden="true" />
    <div class="orb left-[10%] top-[-30%] h-80 w-80 bg-volt-400/15" aria-hidden="true" />

    <div class="tool-container relative py-28 text-center sm:py-36">
      <p class="mono-label" data-reveal>Error 404</p>
      <p class="mt-6 font-display text-8xl font-semibold tracking-[-0.05em] sm:text-[10rem]" data-reveal style="--reveal-delay:100ms">
        4<em class="text-volt-300">0</em>4
      </p>
      <p class="mx-auto mt-4 max-w-xl text-lg text-mist-400" data-reveal style="--reveal-delay:200ms">
        This page wandered off. It happens — even to the best tools.
      </p>
      <div class="mt-8 flex justify-center" data-reveal style="--reveal-delay:300ms">
        <a href="/" class="btn-volt">Back to the toolbox</a>
      </div>
    </div>
  </section>
</Layout>
