---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getTool } from '../../data/tools';
import AIRewriter from '../../components/tools/AIRewriter.tsx';

const tool = getTool('ai-paraphraser')!;
---

<ToolLayout tool={tool}>
  <AIRewriter
    client:load
    mode="paraphrase"
    heading="Paraphrase"
    placeholder="Paste the text you want to rewrite..."
    hint="Your paraphrased text will appear here"
  />
</ToolLayout>
